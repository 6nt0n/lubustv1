    local function updateSelectionVisuals()
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("TextButton") then
                local isSel = (c.Text:gsub("^%s+", "") == selected)
                T(c, TweenInfo.new(0.18, Enum.EasingStyle.Quart), {
                    BackgroundColor3 = isSel and THEME.Element or THEME.Inline,
                    TextColor3 = isSel and THEME.Accent or THEME.TextInactive
                }):Play()
            end
        end
    end

    local function refresh()
        for _, c in ipairs(scroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        pcall(function()
            if listfiles and isfolder and isfolder(Library.ConfigFolder) then
                for _, file in ipairs(listfiles(Library.ConfigFolder)) do
                    local name = file:match("[/\\]([^/\\]+)$"):gsub("%.json$", "")
                    local btn = Instance.new("TextButton")
                    btn.Size = UDim2.new(1, 0, 0, 20)
                    btn.BackgroundColor3 = (selected == name) and THEME.Element or THEME.Inline
                    btn.Text = "  " .. name
                    btn.TextColor3 = (selected == name) and THEME.Accent or THEME.TextInactive
                    btn.Font = Enum.Font.GothamMedium
                    btn.TextSize = 10
                    btn.TextXAlignment = Enum.TextXAlignment.Left
                    btn.AutoButtonColor = false
                    btn.ZIndex = 202
                    btn.Parent = scroll

                    btn.MouseEnter:Connect(function()
                        if selected ~= name then
                            T(btn, TweenInfo.new(0.15), {BackgroundColor3 = THEME["Hovered Element"]}):Play()
                        end
                    end)
                    btn.MouseLeave:Connect(function()
                        if selected ~= name then
                            T(btn, TweenInfo.new(0.15), {BackgroundColor3 = THEME.Inline}):Play()
                        end
                    end)

                    btn.MouseButton1Click:Connect(function()
                        selected = name
                        box.Text = name
                        updateSelectionVisuals()
                    end)
                end
                scroll.CanvasSize = UDim2.new(0, 0, 0, sLayout.AbsoluteContentSize.Y)
            end
        end)
    end

    sLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, sLayout.AbsoluteContentSize.Y)
    end)

    local function makeBtn(txt, parent, xPos, cb, isDelete)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0.48, 0, 1, 0)
        b.Position = UDim2.new(xPos, 0, 0, 0)
        b.BackgroundColor3 = THEME.Inline
        b.Text = txt
        b.TextColor3 = isDelete and Color3.fromRGB(225, 75, 75) or THEME.TextActive
        b.Font = Enum.Font.GothamMedium
        b.TextSize = 10
        b.AutoButtonColor = false
        b.ZIndex = 201
        b.Parent = parent
        AddBorder(b, THEME.Border)

        local baseCol = b.TextColor3
        b.MouseEnter:Connect(function()
            T(b, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
                BackgroundColor3 = THEME["Hovered Element"],
                TextColor3 = isDelete and Color3.fromRGB(255, 100, 100) or THEME.Accent
            }):Play()
        end)
        b.MouseLeave:Connect(function()
            T(b, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
                BackgroundColor3 = THEME.Inline,
                TextColor3 = baseCol
            }):Play()
        end)
        b.MouseButton1Click:Connect(function()
            T(b, TweenInfo.new(0.08, Enum.EasingStyle.Quad), {
                BackgroundColor3 = THEME.Accent,
                TextColor3 = Color3.new(1, 1, 1)
            }):Play()
            task.delay(0.08, function()
                T(b, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
                    BackgroundColor3 = THEME["Hovered Element"],
                    TextColor3 = isDelete and Color3.fromRGB(255, 100, 100) or THEME.Accent
                }):Play()
