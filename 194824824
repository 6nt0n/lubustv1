function Library:Notification(title, msg, duration)
    local tStr = type(title) == "table" and (title.Title or title.Name or "Notice") or tostring(title or "Notice")
    local mStr = type(title) == "table" and (title.Description or title.Text or "") or tostring(msg or "")
    local display = mStr ~= "" and (tStr .. " | " .. mStr) or tStr
    duration = duration or 3

    for _, n in ipairs(Library.ActiveNotifications) do
        if n.display == display then
            n.count = n.count + 1
            n.timer = duration
            local countTxt = n.count > 1 and ' <font color="rgb(160, 160, 160)">(x' .. n.count .. ')</font>' or ''
            n.label.Text = '[<font color="rgb(150, 40, 240)">Slugware</font>] ' .. n.display .. countTxt
            return
        end
    end

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 380, 0, 26)
    label.Position = UDim2.new(0.5, -190, 0.82, 0)
    label.BackgroundTransparency = 1
    label.RichText = true
    label.Text = '[<font color="rgb(150, 40, 240)">Slugware</font>] ' .. display
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 13
    label.Font = Enum.Font.GothamBold
    label.TextStrokeTransparency = 0.6
    label.TextTransparency = 1
    label.ZIndex = 300
    label.Parent = ScreenGui

    local nData = { label = label, display = display, count = 1, timer = duration }
    table.insert(Library.ActiveNotifications, nData)

    local function reposition()
        local total = #Library.ActiveNotifications
        for i, item in ipairs(Library.ActiveNotifications) do
            local idxFromBottom = total - i + 1
            local targetY = 0.78 - ((idxFromBottom - 1) * 0.038)
            T(item.label, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, -190, targetY, 0) }):Play()
        end
    end

    reposition()
    T(label, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { TextTransparency = 0, Position = UDim2.new(0.5, -190, 0.78, 0) }):Play()

    task.spawn(function()
        while nData.timer > 0 do
            task.wait(0.1)
            nData.timer = nData.timer - 0.1
        end
        for idx, item in ipairs(Library.ActiveNotifications) do
            if item == nData then table.remove(Library.ActiveNotifications, idx) break end
        end
        local f = T(label, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { TextTransparency = 1, Position = UDim2.new(0.5, -190, label.Position.Y.Scale - 0.02, 0) })
        f:Play()
        f.Completed:Connect(function() pcall(function() label:Destroy() end) end)
        reposition()
    end)
end
