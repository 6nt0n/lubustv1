        return Library:CreateCategory(n)
    end

    function catObj:AddToggle(tData, defVal, cb)
        local name, def, flag, callback
        if type(tData) == "table" then
            name = tData.Name or tData.name or "Toggle"
            flag = tData.Flag or tData.flag or name
            def = (tData.Default ~= nil) and tData.Default or false
            callback = tData.Callback or tData.callback or function() end
        else
            name = tostring(tData or "Toggle")
            flag = name
            if type(defVal) == "function" then
                callback = defVal; def = false
            else
                def = (defVal ~= nil) and defVal or false
                callback = type(cb) == "function" and cb or function() end
            end
        end

        local toggleObj = { Enabled = def }
        local hasBind = false
        local bindMode = "Toggle"
        local bindActive = false

        local function getEffective()
            if not toggleObj.Enabled then return false end
            if not hasBind then return true end
            if bindMode == "Always" then return true end
            return bindActive
        end

        local tFrame = Instance.new("Frame")
        tFrame.Size = UDim2.new(1, 0, 0, 28)
        tFrame.BackgroundColor3 = THEME.Background
        tFrame.ClipsDescendants = true
        tFrame.Parent = container
        AddBorder(tFrame, THEME.Border)

        local tBtn = Instance.new("TextButton")
        tBtn.Size = UDim2.new(1, 0, 0, 28)
        tBtn.BackgroundTransparency = 1
        tBtn.Text = ""
        tBtn.Parent = tFrame

        local activeBar = Instance.new("Frame")
        activeBar.Size = UDim2.new(0, 3, 0, 14)
        activeBar.Position = UDim2.new(0, 4, 0, 7)
        activeBar.BackgroundColor3 = THEME.Accent
        activeBar.BackgroundTransparency = toggleObj.Enabled and 0 or 1
        activeBar.BorderSizePixel = 0
        activeBar.Parent = tBtn
        RegTheme("Accents", activeBar)

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -32, 1, 0)
        label.Position = UDim2.new(0, 14, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = name
        label.TextColor3 = toggleObj.Enabled and THEME.TextActive or THEME.TextInactive
        label.Font = Enum.Font.GothamMedium
        label.TextSize = 10
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = tBtn

        local gear = Instance.new("TextLabel")
        gear.Size = UDim2.new(0, 18, 1, 0)
        gear.Position = UDim2.new(1, -20, 0, 0)
        gear.BackgroundTransparency = 1
        gear.Text = "..."
        gear.TextColor3 = THEME.SubText
        gear.TextSize = 10
        gear.Font = Enum.Font.GothamBold
        gear.Visible = false
        gear.Parent = tBtn

        local settingsFolder = Instance.new("Frame")
        settingsFolder.Size = UDim2.new(1, -8, 0, 0)
        settingsFolder.Position = UDim2.new(0, 4, 0, 30)
        settingsFolder.BackgroundTransparency = 1
        settingsFolder.Parent = tFrame

        local sLayout = Instance.new("UIListLayout")
        sLayout.Padding = UDim.new(0, 4)
        sLayout.SortOrder = Enum.SortOrder.LayoutOrder
        sLayout.Parent = settingsFolder

        local expanded = false

        local function fire(state)
            toggleObj.Enabled = state
            Library.Flags[flag] = state
            T(activeBar, TweenInfo.new(0.12, Enum.EasingStyle.Quad), { BackgroundTransparency = state and 0 or 1 }):Play()
            T(label, TweenInfo.new(0.12, Enum.EasingStyle.Quad), { TextColor3 = state and THEME.TextActive or THEME.TextInactive }):Play()
            if callback then pcall(callback, getEffective()) end
        end

        local function updateSize()
            local h = 28
            if expanded and gear.Visible then h = 32 + sLayout.AbsoluteContentSize.Y end
            T(tFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quart), { Size = UDim2.new(1, 0, 0, h) }):Play()
            task.delay(0.05, updateTween)
        end

        sLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            if expanded then updateSize() end
        end)

        tBtn.MouseButton1Click:Connect(function() fire(not toggleObj.Enabled) end)
        tBtn.MouseButton2Click:Connect(function()
            if not gear.Visible then return end
            expanded = not expanded
            T(gear, TweenInfo.new(0.18), { TextColor3 = expanded and THEME.Accent or THEME.SubText, Rotation = expanded and 90 or 0 }):Play()
            updateSize()
        end)

        function toggleObj:Keybind(kData)
            gear.Visible = true
            hasBind = true
            local kFlag = type(kData) == "table" and (kData.Flag or kData.flag) or (flag .. "_Keybind")
            local kDef = type(kData) == "table" and (kData.Default or kData.default) or Enum.KeyCode.Unknown
            local kMode = type(kData) == "table" and (kData.Mode or kData.mode) or "Toggle"
            local kCb = type(kData) == "table" and (kData.Callback or kData.callback) or function() end

            bindMode = kMode
            bindActive = (kMode == "Always")

            local kbFrame = Instance.new("Frame")
            kbFrame.Size = UDim2.new(1, 0, 0, 22)
            kbFrame.BackgroundColor3 = THEME.Background
            kbFrame.Parent = settingsFolder
            AddBorder(kbFrame, THEME.Border)

            local kbLbl = Instance.new("TextLabel")
            kbLbl.Size = UDim2.new(0.4, 0, 1, 0)
            kbLbl.Position = UDim2.new(0, 5, 0, 0)
            kbLbl.BackgroundTransparency = 1
            kbLbl.Text = "Keybind"
            kbLbl.TextColor3 = THEME.TextInactive
            kbLbl.Font = Enum.Font.Gotham
            kbLbl.TextSize = 9
            kbLbl.TextXAlignment = Enum.TextXAlignment.Left
            kbLbl.Parent = kbFrame

            local modes = {"Toggle", "Hold", "Always"}
            local mIdx = 1
            for i, m in ipairs(modes) do if m == kMode then mIdx = i break end end

            local mBtn = Instance.new("TextButton")
            mBtn.Size = UDim2.new(0, 44, 0, 16)
            mBtn.Position = UDim2.new(1, -98, 0.5, -8)
            mBtn.BackgroundColor3 = THEME.Background
            mBtn.Text = modes[mIdx]
            mBtn.TextColor3 = THEME.SubText
            mBtn.Font = Enum.Font.GothamMedium
            mBtn.TextSize = 8
            mBtn.AutoButtonColor = false
            mBtn.Parent = kbFrame
            AddBorder(mBtn, THEME.Border)

            local kBtn = Instance.new("TextButton")
            kBtn.Size = UDim2.new(0, 46, 0, 16)
            kBtn.Position = UDim2.new(1, -50, 0.5, -8)
            kBtn.BackgroundColor3 = THEME.Background
            kBtn.Text = tostring(type(kDef) == "userdata" and kDef.Name or kDef)
            kBtn.TextColor3 = THEME.Accent
            kBtn.Font = Enum.Font.GothamBold
            kBtn.TextSize = 8
            kBtn.AutoButtonColor = false
            kBtn.Parent = kbFrame
            RegTheme("TextAccents", kBtn)
            AddBorder(kBtn, THEME.Border)

            local binding = false
            local currKey = kDef

            local function updateKL()
                if Library.KeybindListInstance then
                    if bindMode ~= "Always" and currKey ~= Enum.KeyCode.Unknown then
                        Library.KeybindListInstance:AddOrUpdate(name, tostring(currKey.Name or currKey), getEffective())
                    else
                        Library.KeybindListInstance:Remove(name)
                    end
                end
            end

            mBtn.MouseButton1Click:Connect(function()
                mIdx = (mIdx % #modes) + 1
                bindMode = modes[mIdx]
                mBtn.Text = bindMode
                if bindMode == "Always" then bindActive = true elseif bindMode == "Hold" then bindActive = false end
                if callback then pcall(callback, getEffective()) end
                updateKL()
            end)

            kBtn.MouseButton1Click:Connect(function() binding = true; kBtn.Text = "..." end)

            UserInputService.InputBegan:Connect(function(input, gpe)
                if binding and not gpe then
                    binding = false
                    currKey = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode or input.UserInputType
                    kBtn.Text = tostring(currKey.Name or currKey)
                    updateKL()
                    local bObj = { active = getEffective(), key = currKey, mode = bindMode }
                    Library.Flags[kFlag] = bObj
                    pcall(kCb, bObj)
                elseif not gpe and bindMode ~= "Always" and (input.KeyCode == currKey or input.UserInputType == currKey) then
                    if not toggleObj.Enabled then return end
                    if bindMode == "Toggle" then bindActive = not bindActive elseif bindMode == "Hold" then bindActive = true end
                    if callback then pcall(callback, getEffective()) end
                    updateKL()
                    local bObj = { active = getEffective(), key = currKey, mode = bindMode }
                    Library.Flags[kFlag] = bObj
                    pcall(kCb, bObj)
                end
            end)

            UserInputService.InputEnded:Connect(function(input, gpe)
                if not gpe and bindMode == "Hold" and (input.KeyCode == currKey or input.UserInputType == currKey) then
                    if not toggleObj.Enabled then return end
                    bindActive = false
                    if callback then pcall(callback, getEffective()) end
                    updateKL()
                end
            end)

            Library.Flags[kFlag] = { active = def, key = kDef, mode = bindMode }
            if def then updateKL() end
            return toggleObj
        end

        function toggleObj:Colorpicker(cData)
            gear.Visible = true
            local cpFlag = type(cData) == "table" and (cData.Flag or cData.flag) or (flag .. "_Color")
            local cpDef = type(cData) == "table" and (cData.Default or cData.default) or Color3.fromRGB(255, 255, 255)
            local cpCb = type(cData) == "table" and (cData.Callback or cData.callback) or function() end

            local cpBtn = Instance.new("TextButton")
            cpBtn.Size = UDim2.new(0, 12, 0, 12)
            cpBtn.Position = UDim2.new(1, -34, 0.5, -6)
            cpBtn.BackgroundColor3 = cpDef
            cpBtn.AutoButtonColor = false
            cpBtn.Text = ""
            cpBtn.Parent = tBtn
            AddBorder(cpBtn, THEME.Outline)

            MakeColorPicker(cpBtn, cpDef, function(c)
                cpBtn.BackgroundColor3 = c
                Library.Flags[cpFlag] = c
                pcall(cpCb, c)
            end)

            Library.Flags[cpFlag] = cpDef
            return toggleObj
        end

        fire(def)
        return toggleObj
    end
    function catObj:Toggle(...) return catObj:AddToggle(...) end

    function catObj:AddSlider(sData, minV, maxV, defV, cb)
        local name, min, max, def, suffix, flag, callback
        if type(sData) == "table" then
            name = sData.Name or sData.name or "Slider"
            flag = sData.Flag or sData.flag or name
            min = tonumber(sData.Min or sData.min) or 0
            max = tonumber(sData.Max or sData.max) or 100
            def = tonumber(sData.Default or sData.default) or min
            suffix = sData.Suffix or sData.suffix or ""
            callback = sData.Callback or sData.callback or function() end
        else
            name = tostring(sData or "Slider")
            flag = name
            min = tonumber(minV) or 0
            max = tonumber(maxV) or 100
            if type(defV) == "function" then
                callback = defV; def = min; suffix = ""
            else
                def = tonumber(defV) or min
                if type(cb) == "function" then callback = cb; suffix = ""
                elseif type(cb) == "string" then suffix = cb; callback = function() end
                else suffix = ""; callback = function() end end
            end
        end

        local Slider = { Value = def }
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 30)
        frame.BackgroundColor3 = THEME.Background
        frame.Parent = container
        AddBorder(frame, THEME.Border)

        local sLbl = Instance.new("TextLabel")
        sLbl.Size = UDim2.new(0.6, 0, 0, 13)
        sLbl.Position = UDim2.new(0, 5, 0, 2)
        sLbl.BackgroundTransparency = 1
        sLbl.Text = name
        sLbl.Font = Enum.Font.Gotham
        sLbl.TextSize = 9
        sLbl.TextColor3 = THEME.TextInactive
        sLbl.TextXAlignment = Enum.TextXAlignment.Left
        sLbl.Parent = frame

        local vLbl = Instance.new("TextLabel")
        vLbl.Size = UDim2.new(0.4, 0, 0, 13)
        vLbl.Position = UDim2.new(0.6, -5, 0, 2)
        vLbl.BackgroundTransparency = 1
        vLbl.Text = tostring(def) .. suffix
        vLbl.Font = Enum.Font.GothamBold
        vLbl.TextSize = 9
        vLbl.TextColor3 = THEME.Accent
        vLbl.TextXAlignment = Enum.TextXAlignment.Right
        vLbl.Parent = frame
        RegTheme("TextAccents", vLbl)

        local track = Instance.new("TextButton")
        track.Size = UDim2.new(1, -10, 0, 4)
        track.Position = UDim2.new(0, 5, 0, 18)
        track.BackgroundColor3 = Color3.fromRGB(24, 24, 24)
        track.AutoButtonColor = false
        track.Text = ""
        track.Parent = frame

        local denom = (max - min)
        local ratio = (denom > 0) and ((def - min) / denom) or 0
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(math.clamp(ratio, 0, 1), 0, 1, 0)
        fill.BackgroundColor3 = THEME.Accent
        fill.BorderSizePixel = 0
        fill.Parent = track
        RegTheme("Accents", fill)

        local sliding = false
        local function slide(i)
            local pos = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + (max - min) * pos)
            Slider.Value = val
            Library.Flags[flag] = val
            fill.Size = UDim2.new(pos, 0, 1, 0)
            vLbl.Text = tostring(val) .. suffix
            pcall(callback, val)
        end

        track.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true; slide(i) end end)
        UserInputService.InputChanged:Connect(function(i) if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then slide(i) end end)
        UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end end)

        Library.Flags[flag] = def
        return Slider
    end
    function catObj:Slider(...) return catObj:AddSlider(...) end

    function catObj:AddDropdown(dData, valOrDef, defOrCb, cb)
        local name, items, def, flag, callback
        if type(dData) == "table" then
            name = dData.Name or dData.name or "Dropdown"
            flag = dData.Flag or dData.flag or name
            items = dData.Items or dData.items or dData.Values or {}
            def = dData.Default or dData.default or items[1]
            callback = dData.Callback or dData.callback or function() end
        else
            name = tostring(dData or "Dropdown")
            flag = name
            items = type(valOrDef) == "table" and valOrDef or {}
            if type(defOrCb) == "function" then def = items[1]; callback = defOrCb
            else def = defOrCb or items[1]; callback = type(cb) == "function" and cb or function() end end
        end

        local Dropdown = { Value = def }
        local dFrame = Instance.new("Frame")
        dFrame.Size = UDim2.new(1, 0, 0, 24)
        dFrame.BackgroundColor3 = THEME.Background
        dFrame.ClipsDescendants = true
        dFrame.Parent = container
        AddBorder(dFrame, THEME.Border)

        local mainBtn = Instance.new("TextButton")
        mainBtn.Size = UDim2.new(1, 0, 0, 24)
        mainBtn.BackgroundTransparency = 1
        mainBtn.Text = "  " .. name .. " : " .. tostring(def or "--")
        mainBtn.Font = Enum.Font.GothamMedium
        mainBtn.TextSize = 9
        mainBtn.TextColor3 = THEME.TextActive
        mainBtn.TextXAlignment = Enum.TextXAlignment.Left
        mainBtn.Parent = dFrame

        local dArrow = Instance.new("TextLabel")
        dArrow.Size = UDim2.new(0, 18, 0, 24)
        dArrow.Position = UDim2.new(1, -20, 0, 0)
        dArrow.BackgroundTransparency = 1
        dArrow.Text = "v"
        dArrow.TextColor3 = THEME.SubText
        dArrow.TextSize = 9
        dArrow.Font = Enum.Font.GothamBold
        dArrow.Parent = mainBtn

        local listFolder = Instance.new("Frame")
        listFolder.Size = UDim2.new(1, -8, 0, 0)
        listFolder.Position = UDim2.new(0, 4, 0, 26)
        listFolder.BackgroundTransparency = 1
        listFolder.Parent = dFrame

        local lLayout = Instance.new("UIListLayout")
        lLayout.Padding = UDim.new(0, 3)
        lLayout.SortOrder = Enum.SortOrder.LayoutOrder
        lLayout.Parent = listFolder

        local expanded = false

        local function updateDrop()
            local h = 24
            if expanded then h = 28 + lLayout.AbsoluteContentSize.Y end
            T(dFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quart), { Size = UDim2.new(1, 0, 0, h) }):Play()
            T(dArrow, TweenInfo.new(0.18), { Rotation = expanded and 180 or 0 }):Play()
            task.delay(0.05, updateTween)
        end

        lLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            if expanded then updateDrop() end
        end)

        for _, item in ipairs(items) do
            local iBtn = Instance.new("TextButton")
            iBtn.Size = UDim2.new(1, 0, 0, 18)
            iBtn.BackgroundColor3 = THEME.Inline
            iBtn.Text = "  " .. tostring(item)
            iBtn.Font = Enum.Font.Gotham
            iBtn.TextSize = 9
            iBtn.TextColor3 = (item == def) and THEME.Accent or THEME.TextInactive
            iBtn.TextXAlignment = Enum.TextXAlignment.Left
            iBtn.AutoButtonColor = false
            iBtn.Parent = listFolder
            AddBorder(iBtn, THEME.Border)

            iBtn.MouseButton1Click:Connect(function()
                Dropdown.Value = item
                Library.Flags[flag] = item
                mainBtn.Text = "  " .. name .. " : " .. tostring(item)
                for _, child in ipairs(listFolder:GetChildren()) do
                    if child:IsA("TextButton") then
                        child.TextColor3 = (child.Text:sub(3) == tostring(item)) and THEME.Accent or THEME.TextInactive
                    end
                end
                expanded = false
                updateDrop()
                pcall(callback, item)
            end)
        end

        mainBtn.MouseButton1Click:Connect(function() expanded = not expanded; updateDrop() end)
        Library.Flags[flag] = def
        return Dropdown
    end
    function catObj:Dropdown(...) return catObj:AddDropdown(...) end

    function catObj:AddButton(text, cb)
        local bName = type(text) == "table" and (text.Name or text.name) or tostring(text or "Button")
        local callback = type(text) == "table" and (text.Callback or text.callback) or cb

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 24)
        btn.BackgroundColor3 = THEME.Background
        btn.AutoButtonColor = false
        btn.Text = bName
        btn.TextColor3 = THEME.TextInactive
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 10
        btn.Parent = container
        AddBorder(btn, THEME.Border)

        btn.MouseButton1Click:Connect(function()
            T(btn, TweenInfo.new(0.08), { BackgroundColor3 = THEME.Accent }):Play()
            task.delay(0.08, function() T(btn, TweenInfo.new(0.12), { BackgroundColor3 = THEME.Background }):Play() end)
            if callback then pcall(callback) end
        end)
    end
    function catObj:Button(...) return catObj:AddButton(...) end

    task.defer(updateTween)
    catObj.Frame = frame
    table.insert(Library.Categories, catObj)
    return catObj
end

function Library:Window(d)
    local Window = { Pages = {} }
    function Window:Page(pData)
        local name = type(pData) == "table" and (pData.Name or pData.name) or tostring(pData or "Category")
        local page = Library:CreateCategory(name)
        table.insert(Window.Pages, page)
        return page
    end
    return Window
end

function Library:CreateSettingsPage(Window, wm, kl)
    local cat = Library:CreateCategory("Settings")

    if wm then cat:AddToggle("Watermark", true, function(s) wm:SetVisible(s) end) end
    if kl then cat:AddToggle("Keybind List", true, function(s) kl:SetVisible(s) end) end

    local popup = CreateConfigPopup()
    cat:AddButton("Config Manager", function() popup:ToggleVisible() end)

    local acToggle = cat:AddToggle("Menu Accent Color", true)
    acToggle:Colorpicker({
        Flag = "MenuAccentColor",
        Default = THEME.Accent,
        Callback = function(c) Library:ChangeTheme("Accent", c) end
    })

    local mKeyToggle = cat:AddToggle("Menu Keybind", true)
    mKeyToggle:Keybind({
        Flag = "MenuKeybindFlag",
        Default = Library.ToggleKey,
        Callback = function(b) if b and b.key then Library:SetToggleKey(b.key) end end
    })

    cat:AddButton("Unload UI", function() Library:Unload() end)
    return cat
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and (input.KeyCode == Library.ToggleKey or input.UserInputType == Library.ToggleKey) then
        Library.Visible = not Library.Visible
        searchFrame.Visible = Library.Visible

        if not Library.Visible and ConfigPopup and ConfigPopup.IsOpen then
            ConfigPopup:ToggleVisible()
        end

        for _, cat in pairs(Library.Categories) do
            if Library.Visible then
                cat.Frame.Visible = true
                cat.Frame.Position = cat.CurrentPosition - UDim2.new(0, 0, 0, 18)
                cat.Frame.BackgroundTransparency = 1
                T(cat.Frame, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                    Position = cat.CurrentPosition,
                    BackgroundTransparency = 0
                }):Play()
            else
                local tw = T(cat.Frame, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                    Position = cat.CurrentPosition - UDim2.new(0, 0, 0, 18),
                    BackgroundTransparency = 1
                })
                tw:Play()
                tw.Completed:Connect(function()
                    if not Library.Visible then cat.Frame.Visible = false end
                end)
            end
        end
    end
end)

function Library:Unload()
    for _, conn in ipairs(Library.Connections) do pcall(function() conn:Disconnect() end) end
    if ScreenGui then ScreenGui:Destroy() end
    getgenv().Library = nil
    getgenv().library = nil
end

function Library:unload_menu() Library:Unload() end

getgenv().Library = Library
getgenv().library = Library
return Library
