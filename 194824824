    local function updateTween()
        local contentHeight = cLayout.AbsoluteContentSize.Y + 11
        local screenH = ScreenGui.AbsoluteSize.Y
        if screenH <= 0 then
            pcall(function() screenH = workspace.CurrentCamera.ViewportSize.Y end)
        end
        if screenH <= 0 then screenH = 600 end
        
        local yOffset = frame.AbsolutePosition.Y
        if yOffset <= 0 then yOffset = catObj.CurrentPosition.Y.Offset end
        local maxScreenHeight = math.max(180, screenH - yOffset - 35)
        
        local h = 0
        if not catObj.Collapsed then
            h = math.min(contentHeight, maxScreenHeight)
        end
        
        container.CanvasSize = UDim2.new(0, 0, 0, contentHeight)
        T(container, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, h) }):Play()
        T(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(0, 180, 0, 32 + h) }):Play()
        T(arrow, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Rotation = catObj.Collapsed and -90 or 0 }):Play()
    end

    cLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        if not catObj.Collapsed then updateTween() end
    end)

    header.MouseButton2Click:Connect(function()
        catObj.Collapsed = not catObj.Collapsed
        updateTween()
    end)

