end

local function AddBorder(parent, col, thick)
    local s = Instance.new("UIStroke")
    s.Thickness = thick or 1
    s.Color = col or THEME.Border
    s.LineJoinMode = Enum.LineJoinMode.Miter
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function MakeDrag(frame, handle, callback)
    local dragging, dragStart, startPos
    handle = handle or frame
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            local target = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            T(frame, TweenInfo.new(0.08, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = target}):Play()
            if callback then callback(target) end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            if callback then callback(frame.Position) end
        end
    end)
end

function Library:SaveConfig(name)
    if not writefile then return end
    name = name or "default"
    local success, encoded = pcall(function()
        local data = { Flags = {}, CategoryPositions = {} }
        for f, v in pairs(Library.Flags) do
            if typeof(v) == "Color3" then
                data.Flags[f] = {type = "Color3", r = v.R, g = v.G, b = v.B}
            elseif typeof(v) == "EnumItem" then
                data.Flags[f] = {type = "EnumItem", enumType = tostring(v.EnumType), name = v.Name}
            elseif type(v) == "table" then
                local copy = {}
                for sk, sv in pairs(v) do
                    if typeof(sv) == "EnumItem" then
                        copy[sk] = {type = "EnumItem", enumType = tostring(sv.EnumType), name = sv.Name}
                    else
                        copy[sk] = sv
                    end
                end
                data.Flags[f] = copy
            elseif type(v) ~= "function" and type(v) ~= "userdata" then
                data.Flags[f] = v
            end
        end
        for _, cat in ipairs(Library.Categories) do
            if cat.Name and cat.CurrentPosition then
                data.CategoryPositions[cat.Name] = {
                    xs = cat.CurrentPosition.X.Scale, xo = cat.CurrentPosition.X.Offset,
                    ys = cat.CurrentPosition.Y.Scale, yo = cat.CurrentPosition.Y.Offset
                }
            end
        end
        return HttpService:JSONEncode(data)
    end)
    if success and encoded then
        writefile(Library.ConfigFolder .. "/" .. name .. ".json", encoded)
        Library:Notification("Config", "Saved config: " .. name, 2)
    end
end

function Library:LoadConfig(name)
    if not readfile or not isfile then return end
    name = name or "default"
    local path = Library.ConfigFolder .. "/" .. name .. ".json"
    if isfile(path) then
        local success, decoded = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
        if success and type(decoded) == "table" then
            local flags = decoded.Flags or decoded
            for f, v in pairs(flags) do
                if type(v) == "table" then
                    if v.type == "Color3" then
                        Library.Flags[f] = Color3.new(v.r, v.g, v.b)
                    elseif v.type == "EnumItem" then
                        pcall(function() Library.Flags[f] = Enum[v.enumType][v.name] end)
                    else
                        local rec = {}
                        for sk, sv in pairs(v) do
                            if type(sv) == "table" and sv.type == "EnumItem" then
                                pcall(function() rec[sk] = Enum[sv.enumType][sv.name] end)
                            else
                                rec[sk] = sv
                            end
                        end
                        Library.Flags[f] = rec
                    end
                else
                    Library.Flags[f] = v
                end
            end
            if decoded.CategoryPositions then
                for _, cat in ipairs(Library.Categories) do
                    local pos = decoded.CategoryPositions[cat.Name]
                    if pos then
                        local newPos = UDim2.new(pos.xs, pos.xo, pos.ys, pos.yo)
                        cat.CurrentPosition = newPos
                        if cat.Frame then cat.Frame.Position = newPos end
                    end
                end
            end
            Library:Notification("Config", "Loaded config: " .. name, 2)
        end
    end
end

