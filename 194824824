    row1.Position = UDim2.new(0, 8, 0, 188)
    row1.BackgroundTransparency = 1
    row1.ZIndex = 201
    row1.Parent = frame

    makeBtn("Create", row1, 0, function()
        local n = box.Text
        if n ~= "" then Library:SaveConfig(n); selected = n; refresh() end
    end)
    makeBtn("Load", row1, 0.52, function()
        local n = selected or box.Text
        if n ~= "" then Library:LoadConfig(n) end
    end)

    local row2 = Instance.new("Frame")
    row2.Size = UDim2.new(1, -16, 0, 22)
    row2.Position = UDim2.new(0, 8, 0, 214)
    row2.BackgroundTransparency = 1
    row2.ZIndex = 201
    row2.Parent = frame

    makeBtn("Overwrite", row2, 0, function()
        local n = selected or box.Text
        if n ~= "" then Library:SaveConfig(n); refresh() end
    end)
    
    makeBtn("Delete", row2, 0.52, function()
        local n = selected or box.Text
        if n ~= "" and delfile and isfile and isfile(Library.ConfigFolder .. "/" .. n .. ".json") then
            pcall(function() delfile(Library.ConfigFolder .. "/" .. n .. ".json") end)
            selected = nil; box.Text = ""
            refresh()
            Library:Notification("Config", "Deleted config: " .. n, 2)
        end
    end, true)

    Popup = {}
    Popup.Frame = frame
    Popup.IsOpen = false

    function Popup:ToggleVisible()
        Popup.IsOpen = not Popup.IsOpen
        if Popup.IsOpen then
            frame.Visible = true
            frame.Size = UDim2.new(0, 220, 0, 240)
            frame.BackgroundTransparency = 1
            T(frame, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 240, 0, 260),
                BackgroundTransparency = 0
            }):Play()
            refresh()
        else
            local tw = T(frame, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 220, 0, 240),
                BackgroundTransparency = 1
            })
            tw:Play()
            tw.Completed:Connect(function()
                if not Popup.IsOpen then frame.Visible = false end
            end)
        end
    end

    ConfigPopup = Popup
    return Popup
end

